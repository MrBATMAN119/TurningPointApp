{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turningpoint-church",
  "compatibility_date": "2025-08-20",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "turningpoint-church-production",
      "database_id": "placeholder-will-be-created",
      "preview_database_id": "placeholder-will-be-created"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}